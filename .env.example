# ──────────────────────────────────────────────────────────────────────
# Portfolio backend muhit o'zgaruvchilari
# Bu faylni `.env` ga nusxa olib, qiymatlarni o'zgartirib qo'ying.
# `.env` git ga tushmaydi (.gitignore da)
# ──────────────────────────────────────────────────────────────────────

# ── Django asosiy ──────────────────────────────────────────────────────
# `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` orqali yarating
SECRET_KEY=change-me-to-a-50-char-random-string

# Production'da False ga qo'ying
DEBUG=True

# Vergul bilan ajratilgan host nomlari. Productionda ['*'] ishlatmang!
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS POST so'rovlari uchun ishonchli origin'lar (sxema bilan).
# Misol: CSRF_TRUSTED_ORIGINS=https://portfolio.madaniyhayot.uz
CSRF_TRUSTED_ORIGINS=

# ── Database ───────────────────────────────────────────────────────────
# Vaqtinchalik SQLite uchun: USE_SQLITE=1
USE_SQLITE=0

DB_ENGINE=django.db.backends.postgresql
DB_NAME=portfolio_db
DB_USER=portfolio
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# ── CORS (FastAPI) ─────────────────────────────────────────────────────
# Vergul bilan ajratilgan origin URL'lari
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── Cache ──────────────────────────────────────────────────────────────
# locmem (default) yoki redis://127.0.0.1:6379/1
CACHE_BACKEND=locmem
# Sekundlarda. Statik endpoint'lar uchun TTL.
CACHE_TTL=300
